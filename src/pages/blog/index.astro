---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog')).filter((p) => !p.data.draft).sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout title="Blog | GNTECH Engineering Notes">
  <h1 class="text-3xl font-bold">Blog</h1>
  <div class="mt-6 grid gap-4">
    {posts.map((post) => (
      <a href={`/blog/${post.slug}/`} class="rounded-xl border border-slate-800 bg-slate-900 p-5 no-underline hover:border-sky-500">
        <div class="text-sm text-sky-300">{post.data.category} · {post.data.risk_level} risk</div>
        <h2 class="mt-1 text-xl font-semibold text-white">{post.data.title}</h2>
        <p class="mt-2 text-slate-300">{post.data.description}</p>
      </a>
    ))}
  </div>
</BaseLayout>
