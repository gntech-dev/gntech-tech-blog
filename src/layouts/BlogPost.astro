---
import BaseLayout from './BaseLayout.astro';
import GiscusComments from '../components/GiscusComments.astro';
const { frontmatter } = Astro.props;
---
<BaseLayout title={`${frontmatter.title} | GNTECH Engineering Notes`} description={frontmatter.description}>
  <article class="mx-auto max-w-3xl" data-pagefind-body>
    <header class="mb-10 rounded-3xl border border-slate-800 bg-panel/80 p-6 shadow-2xl shadow-sky-950/20 md:p-8">
      <p class="mb-4 text-sm font-semibold uppercase tracking-[0.24em] text-sky-300">{frontmatter.category} · {frontmatter.risk_level} risk</p>
      <h1 class="text-balance text-4xl font-black tracking-tight text-white md:text-5xl">{frontmatter.title}</h1>
      <p class="mt-5 text-xl leading-8 text-slate-300">{frontmatter.description}</p>
      <div class="mt-6 flex flex-wrap gap-3 text-sm text-slate-300">
        <span class="rounded-full border border-slate-700 bg-slate-900 px-3 py-1">Published: {new Date(frontmatter.pubDate).toLocaleDateString('en-US')}</span>
        {frontmatter.updatedDate && <span class="rounded-full border border-slate-700 bg-slate-900 px-3 py-1">Updated: {new Date(frontmatter.updatedDate).toLocaleDateString('en-US')}</span>}
        <span class="rounded-full border border-slate-700 bg-slate-900 px-3 py-1">Validated by: {frontmatter.validated_by}</span>
      </div>
    </header>
    <div class="prose prose-invert prose-lg max-w-none prose-headings:scroll-mt-24 prose-headings:font-bold prose-h2:mt-14 prose-h2:border-b prose-h2:border-slate-800 prose-h2:pb-3 prose-h2:text-3xl prose-h3:text-2xl prose-p:leading-8 prose-a:text-sky-300 prose-a:decoration-sky-500/50 hover:prose-a:text-sky-200 prose-strong:text-white prose-code:text-sky-200 prose-pre:border prose-pre:border-slate-700 prose-pre:bg-slate-950 prose-table:text-sm prose-th:border prose-th:border-slate-700 prose-th:bg-slate-900 prose-th:p-3 prose-td:border prose-td:border-slate-800 prose-td:p-3 prose-blockquote:border-sky-400 prose-blockquote:bg-slate-900/70 prose-blockquote:px-5 prose-blockquote:py-2 prose-blockquote:not-italic">
      <slot />
    </div>
  </article>
  <div class="mx-auto max-w-3xl">
    <GiscusComments />
  </div>
</BaseLayout>
